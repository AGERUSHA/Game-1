@model GameInfo
@* Illustrated cover for a game (SVG, 320×180). Colors follow the game's category. *@
@{
    var id = "gc" + Guid.NewGuid().ToString("N")[..8];
    var (c1, c2, acc, deep) = Model.Category switch
    {
        "data" => ("#CFFAFE", "#67E8F9", "#0E9FB0", "#155E75"),
        "web" => ("#FCE7F3", "#F9A8D4", "#DB2777", "#831843"),
        "algo" => ("#E0E7FF", "#A5B4FC", "#4F46E5", "#312E81"),
        "sec" => ("#0B1220", "#14532D", "#22C55E", "#052E16"),
        "quiz" => ("#FEF3C7", "#FCD34D", "#F59E0B", "#78350F"),
        _ => ("#EDE9FE", "#C4B5FD", "#7C3AED", "#4C1D95"),
    };
}
<svg class="game-cover" viewBox="0 0 320 180" role="img" aria-label="@Model.Title" preserveAspectRatio="xMidYMid slice">
    <defs>
        <linearGradient id="@(id)bg" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="@c1" /><stop offset="1" stop-color="@c2" /></linearGradient>
        <linearGradient id="@(id)ac" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="@acc" stop-opacity=".95" /><stop offset="1" stop-color="@deep" /></linearGradient>
        <filter id="@(id)sh" x="-20%" y="-20%" width="140%" height="160%"><feDropShadow dx="0" dy="6" stdDeviation="6" flood-color="@deep" flood-opacity=".28" /></filter>
    </defs>
    <rect width="320" height="180" fill="url(#@(id)bg)" />
    <circle cx="290" cy="20" r="70" fill="#fff" opacity=".18" />
    <circle cx="20" cy="170" r="54" fill="#fff" opacity=".14" />

    @switch (Model.Id)
    {
        case "kodl":
            {
                var rows = new[] { ("CLASS", "xgxxy"), ("ARRAY", "ggggg") };
                <g filter="url(#@(id)sh)">
                    @for (var r = 0; r < 3; r++)
                    {
                        for (var c = 0; c < 5; c++)
                        {
                            var x = 70 + c * 38; var y = 26 + r * 44;
                            var state = r < 2 ? rows[r].Item2[c] : 'e';
                            var fill = state == 'g' ? "#16A34A" : state == 'y' ? "#F59E0B" : state == 'x' ? "#94A3B8" : "#FFFFFF";
                            <rect x="@x" y="@y" width="32" height="36" rx="7" fill="@fill" stroke="@(state == 'e' ? deep : fill)" stroke-opacity=".25" />
                            if (r < 2) { <g><text x="@(x + 16)" y="@(y + 25)" text-anchor="middle" font-family="JetBrains Mono, monospace" font-weight="800" font-size="18" fill="#fff">@rows[r].Item1[c]</text></g> }
                        }
                    }
                </g>
                break;
            }
        case "bughunt":
            <g filter="url(#@(id)sh)">
                <rect x="40" y="28" width="200" height="128" rx="12" fill="#1E1736" />
                <circle cx="56" cy="42" r="4" fill="#F87171" /><circle cx="68" cy="42" r="4" fill="#FBBF24" /><circle cx="80" cy="42" r="4" fill="#34D399" />
                <rect x="56" y="58" width="110" height="8" rx="4" fill="#8B5CF6" opacity=".8" />
                <rect x="68" y="74" width="140" height="8" rx="4" fill="#C4B5FD" opacity=".55" />
                <rect x="48" y="88" width="184" height="16" rx="5" fill="#DC2626" opacity=".35" />
                <rect x="68" y="92" width="96" height="8" rx="4" fill="#FCA5A5" />
                <rect x="68" y="112" width="120" height="8" rx="4" fill="#C4B5FD" opacity=".55" />
                <rect x="56" y="128" width="60" height="8" rx="4" fill="#8B5CF6" opacity=".8" />
            </g>
            <g transform="translate(196 72)">
                <circle r="34" fill="#fff" fill-opacity=".35" stroke="@deep" stroke-width="7" />
                <line x1="24" y1="24" x2="52" y2="52" stroke="@deep" stroke-width="11" stroke-linecap="round" />
                <ellipse cx="0" cy="2" rx="11" ry="14" fill="#DC2626" /><circle cx="0" cy="-14" r="7" fill="#7F1D1D" />
                <path d="M-11 -2 h-9 M-11 6 h-9 M11 -2 h9 M11 6 h9 M-4 -20 l-4 -7 M4 -20 l4 -7" stroke="#7F1D1D" stroke-width="2.5" stroke-linecap="round" />
            </g>
            break;
        case "output":
            <g filter="url(#@(id)sh)">
                <rect x="48" y="30" width="224" height="122" rx="12" fill="#1E1736" />
                <g><text x="68" y="68" font-family="JetBrains Mono, monospace" font-size="15" fill="#C4B5FD">print(2 ** 5 + 10)</text></g>
                <g><text x="68" y="104" font-family="JetBrains Mono, monospace" font-size="15" fill="#34D399">&gt;</text></g>
                <g><text x="88" y="106" font-family="JetBrains Mono, monospace" font-weight="800" font-size="30" fill="#fff">42</text></g>
                <rect x="136" y="84" width="12" height="24" fill="#34D399" opacity=".9"><animate attributeName="opacity" values="1;0;1" dur="1.1s" repeatCount="indefinite" /></rect>
            </g>
            <circle cx="262" cy="40" r="22" fill="@acc" /><g><text x="262" y="49" text-anchor="middle" font-weight="800" font-size="26" fill="#fff">?</text></g>
            break;
        case "puzzle":
            <g filter="url(#@(id)sh)">
                <rect x="40" y="36" width="170" height="26" rx="8" fill="#fff" /><rect x="52" y="45" width="90" height="8" rx="4" fill="@acc" />
                <rect x="64" y="70" width="170" height="26" rx="8" fill="#fff" /><rect x="76" y="79" width="120" height="8" rx="4" fill="@deep" opacity=".7" />
                <rect x="64" y="138" width="150" height="26" rx="8" fill="#fff" /><rect x="76" y="147" width="70" height="8" rx="4" fill="@acc" />
                <g transform="translate(110 100) rotate(-6)"><rect width="176" height="28" rx="8" fill="url(#@(id)ac)" /><rect x="14" y="10" width="110" height="8" rx="4" fill="#fff" opacity=".9" /></g>
            </g>
            <path d="M270 70 q20 20 0 42" stroke="@deep" stroke-width="4" fill="none" stroke-dasharray="6 6" stroke-linecap="round" />
            break;
        case "sqldet":
            <g filter="url(#@(id)sh)">
                <rect x="36" y="26" width="190" height="130" rx="10" fill="#fff" />
                @for (var r = 0; r < 5; r++) { <rect x="48" y="@(40 + r * 22)" width="166" height="14" rx="3" fill="@(r == 0 ? acc : r == 3 ? "#FDE68A" : "#E2E8F0")" /> }
            </g>
            <path d="M226 54 L262 40 M226 120 L270 132" stroke="#DC2626" stroke-width="2.5" />
            <circle cx="266" cy="38" r="16" fill="#FCD34D" stroke="#B45309" stroke-width="3" /><g><text x="266" y="44" text-anchor="middle" font-size="16">🦉</text></g>
            <g transform="translate(250 104)"><circle r="26" fill="#fff" fill-opacity=".4" stroke="@deep" stroke-width="6" /><line x1="18" y1="18" x2="40" y2="40" stroke="@deep" stroke-width="9" stroke-linecap="round" /></g>
            <circle cx="226" cy="54" r="5" fill="#DC2626" /><circle cx="226" cy="120" r="5" fill="#DC2626" />
            break;
        case "sort":
            {
                var hs = new[] { 46, 88, 62, 120, 30, 104, 76 };
                <g filter="url(#@(id)sh)">
                    @for (var i = 0; i < hs.Length; i++)
                    {
                        var x = 52 + i * 32; var y = 156 - hs[i];
                        <path d="M@(x) @(y + 8) L@(x + 11) @(y) L@(x + 22) @(y + 8) V156 H@(x) Z" fill="url(#@(id)ac)" opacity="@(i == 1 || i == 4 ? "1" : ".72")" />
                        <path d="M@(x + 4) @(y + 10) L@(x + 11) @(y + 5) V150 H@(x + 4) Z" fill="#fff" opacity=".35" />
                    }
                </g>
                <path d="M95 40 C110 18, 170 18, 186 46" stroke="@deep" stroke-width="3.5" fill="none" stroke-linecap="round" />
                <path d="M180 38 l7 9 l-11 2" stroke="@deep" stroke-width="3.5" fill="none" stroke-linecap="round" stroke-linejoin="round" />
                break;
            }
        case "robot":
            <g filter="url(#@(id)sh)">
                @for (var r = 0; r < 3; r++)
                {
                    for (var c = 0; c < 4; c++)
                    {
                        var cx = 160 + (c - r) * 34; var cy = 60 + (c + r) * 19;
                        <path d="M@(cx) @(cy - 19) L@(cx + 34) @(cy) L@(cx) @(cy + 19) L@(cx - 34) @(cy) Z" fill="@((r + c) % 2 == 0 ? "#fff" : c1)" stroke="@acc" stroke-opacity=".35" />
                    }
                }
            </g>
            <g transform="translate(126 78)">
                <rect x="-16" y="-26" width="32" height="28" rx="9" fill="url(#@(id)ac)" />
                <circle cx="-6" cy="-13" r="5" fill="#fff" /><circle cx="6" cy="-13" r="5" fill="#fff" /><circle cx="-6" cy="-13" r="2.2" fill="#1B1530" /><circle cx="6" cy="-13" r="2.2" fill="#1B1530" />
                <path d="M0 -26 v-8" stroke="@deep" stroke-width="3" /><circle cx="0" cy="-36" r="4" fill="#F59E0B" />
                <ellipse cx="0" cy="6" rx="16" ry="5" fill="@deep" opacity=".25" />
            </g>
            <g><text x="232" y="110" font-size="26">⭐</text></g>
            break;
        case "regex":
            <g filter="url(#@(id)sh)">
                <rect x="34" y="44" width="252" height="54" rx="12" fill="#fff" />
                <g><text x="160" y="80" text-anchor="middle" font-family="JetBrains Mono, monospace" font-weight="800" font-size="24" fill="@deep">/^\d{3}-\w+$/</text></g>
            </g>
            <g font-family="JetBrains Mono, monospace" font-size="13" font-weight="700">
                <rect x="40" y="114" width="112" height="26" rx="13" fill="#16A34A" /><g><text x="96" y="132" text-anchor="middle" fill="#fff">✓ 101-ok</text></g>
                <rect x="168" y="114" width="112" height="26" rx="13" fill="#DC2626" /><g><text x="224" y="132" text-anchor="middle" fill="#fff">✗ ab-12</text></g>
            </g>
            break;
        case "blitz":
            <g filter="url(#@(id)sh)">
                <circle cx="160" cy="92" r="58" fill="#fff" />
                <circle cx="160" cy="92" r="58" fill="none" stroke="@acc" stroke-width="10" stroke-dasharray="270 400" transform="rotate(-90 160 92)" stroke-linecap="round" />
                <rect x="150" y="22" width="20" height="14" rx="4" fill="@deep" />
                <path d="M170 52 L140 98 H162 L150 134 L184 82 H162 Z" fill="url(#@(id)ac)" />
            </g>
            break;
        case "fortress":
            <g filter="url(#@(id)sh)">
                <path d="M110 150 V80 h16 v-12 h14 v12 h16 v-12 h14 v12 h16 v-12 h14 v12 h16 V150 Z" fill="#1E293B" stroke="@acc" stroke-width="2.5" />
                <path d="M160 92 l22 9 v18 c0 14 -10 22 -22 27 c-12 -5 -22 -13 -22 -27 v-18 Z" fill="@acc" opacity=".9" />
            </g>
            <path d="M20 40 H90 M20 70 H80 M230 50 H300 M240 84 H300" stroke="#F43F5E" stroke-width="3" stroke-dasharray="8 6" />
            <g><text x="160" y="126" text-anchor="middle" font-family="JetBrains Mono, monospace" font-size="14" font-weight="800" fill="#052E16">OK</text></g>
            break;
        case "garden":
            <g filter="url(#@(id)sh)">
                @for (var i = 0; i < 4; i++)
                {
                    var x = 58 + i * 56;
                    <path d="M@(x) 116 h40 l-6 34 h-28 Z" fill="url(#@(id)ac)" />
                    <path d="M@(x + 20) 116 C@(x + 4) 96, @(x + 8) 80, @(x + 20) 72 C@(x + 32) 80, @(x + 36) 96, @(x + 20) 116" fill="#22C55E" />
                }
            </g>
            <g><text x="160" y="46" text-anchor="middle" font-family="JetBrains Mono, monospace" font-size="16" font-weight="700" fill="@deep">display: flex;</text></g>
            break;
        case "duel":
            <g filter="url(#@(id)sh)">
                <circle cx="92" cy="90" r="40" fill="#fff" /><g><text x="92" y="103" text-anchor="middle" font-size="36">🦉</text></g>
                <circle cx="228" cy="90" r="40" fill="#fff" /><g><text x="228" y="103" text-anchor="middle" font-size="36">🤖</text></g>
            </g>
            <g><text x="160" y="100" text-anchor="middle" font-weight="900" font-size="30" fill="@deep">VS</text></g>
            break;
        case "senior":
            <g filter="url(#@(id)sh)">
                @for (var i = 0; i < 5; i++) { <rect x="@(70 + i * 38)" y="@(140 - i * 20)" width="30" height="@(16 + i * 20)" rx="6" fill="url(#@(id)ac)" opacity="@(0.55 + i * 0.1)" /> }
            </g>
            <path d="M226 34 l10 16 l14 -12 l-4 26 h-40 l-4 -26 l14 12 Z" fill="#F59E0B" stroke="@deep" stroke-width="2" />
            break;
        case "git":
            <path d="M50 120 H270 M110 120 C130 120, 130 70, 150 70 H220 C240 70, 240 120, 260 120" stroke="@acc" stroke-width="6" fill="none" stroke-linecap="round" />
            @foreach (var (x, y) in new[] { (60, 120), (110, 120), (180, 120), (160, 70), (210, 70), (260, 120) })
            {
                <circle cx="@x" cy="@y" r="11" fill="#0B1220" stroke="@acc" stroke-width="4" />
            }
            <g><text x="160" y="46" text-anchor="middle" font-family="JetBrains Mono, monospace" font-size="15" font-weight="700" fill="@acc">git merge feature</text></g>
            break;
    }
</svg>
