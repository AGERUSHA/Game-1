@model LessonPage
@{
    var l = Model.Lesson;
    ViewData["Title"] = l.Title;
    ViewData["Nav"] = "courses";
    var done = l.Status == "completed";
    var (typeIcon, typeName) = l.Type switch
    {
        "video" => ("play-circle", L.T("Видео", "Бейне", "Video")),
        "test" => ("clipboard-check", L.T("Тест", "Тест", "Quiz")),
        "assignment" => ("file-code-2", L.T("Задание", "Тапсырма", "Assignment")),
        _ => ("file-text", L.T("Статья", "Мақала", "Article")),
    };
    var paragraphs = Model.Body.Replace("\r", "").Split("\n\n", StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
}

<nav class="breadcrumbs">
    <a href="/Student/Courses">@L.T("Курсы", "Курстар", "Courses")</a> @Html.Icon("chevron-right")
    <a href="/Student/CourseDetails/@Model.Course.Id">@Model.Course.Title</a> @Html.Icon("chevron-right")
    <span>@l.Title</span>
</nav>

<div class="grid cols-main-side">
    <article class="card card-lg col gap-5">
        <div class="col gap-2">
            <div class="flex gap-2 wrap items-center">
                <span class="badge badge-primary">@Html.Icon(typeIcon) @typeName</span>
                @if (l.Duration.Length > 0) { <span class="badge">@Html.Icon("clock") @l.Duration</span> }
                @if (done) { <span class="badge badge-success">@Html.Icon("check") @L.T("Пройдено", "Өтілді", "Completed")</span> }
            </div>
            <div class="text-sm muted">@Model.Module</div>
            <h1 style="font-size:28px">@l.Title</h1>
        </div>

        @if (Model.VideoEmbed != null)
        {
            <div style="position:relative;padding-top:56.25%;border-radius:14px;overflow:hidden;background:#000">
                <iframe src="@Model.VideoEmbed" title="@l.Title" style="position:absolute;inset:0;width:100%;height:100%;border:0"
                        allow="accelerometer; encrypted-media; gyroscope; picture-in-picture; fullscreen" allowfullscreen loading="lazy"></iframe>
            </div>
        }
        else if (l.Type == "video")
        {
            <div class="cover cover-@Model.Course.Cover" style="border-radius:14px;min-height:220px;display:grid;place-items:center;text-align:center;padding:24px">
                <div class="col gap-2 items-center" style="color:#fff">
                    @Html.Icon("video", "icon-lg")
                    <b>@L.T("Видео скоро добавит преподаватель", "Бейнені жақында оқытушы қосады", "The teacher will add the video soon")</b>
                    <span class="text-sm" style="opacity:.85">@L.T("А пока — конспект урока ниже.", "Әзірге — төмендегі сабақ конспектісі.", "Meanwhile, here are the lesson notes.")</span>
                </div>
            </div>
        }

        <div class="col gap-4" style="font-size:16px;line-height:1.7;max-width:720px">
            @foreach (var p in paragraphs)
            {
                <p style="margin:0">@Html.Raw(string.Join("<br>", p.Split('\n').Select(System.Net.WebUtility.HtmlEncode)))</p>
            }
        </div>

        @if (l.Type == "test")
        {
            <div class="card card-soft flex gap-3 items-center wrap">
                <span class="ibox">@Html.Icon("clipboard-check")</span>
                <div class="grow"><b>@L.T("Тест по модулю", "Модуль бойынша тест", "Module quiz")</b><div class="text-sm muted">@L.T("Тесты курса — в разделе «Тесты».", "Курс тесттері — «Тесттер» бөлімінде.", "Course quizzes are in the Tests section.")</div></div>
                <a class="btn btn-secondary" href="/Student/Tests">@L.T("К тестам", "Тесттерге", "Go to tests") @Html.Icon("arrow-right", "icon-sm")</a>
            </div>
        }
        else if (l.Type == "assignment")
        {
            <div class="card card-soft flex gap-3 items-center wrap">
                <span class="ibox">@Html.Icon("file-code-2")</span>
                <div class="grow"><b>@L.T("Практическое задание", "Практикалық тапсырма", "Practical assignment")</b><div class="text-sm muted">@L.T("Сдать работу можно в разделе «Задания».", "Жұмысты «Тапсырмалар» бөлімінде тапсыруға болады.", "Hand in your work in the Assignments section.")</div></div>
                <a class="btn btn-secondary" href="/Student/Assignments">@L.T("К заданиям", "Тапсырмаларға", "Go to assignments") @Html.Icon("arrow-right", "icon-sm")</a>
            </div>
        }

        <div class="flex gap-3 wrap items-center" style="border-top:1px solid var(--border);padding-top:20px">
            @if (Model.PrevId is int prev)
            {
                <a class="btn btn-outline" href="/Student/Lesson/@prev">@Html.Icon("arrow-left", "icon-sm") @L.T("Назад", "Артқа", "Back")</a>
            }
            <div class="grow"></div>
            @if (!done)
            {
                <form method="post" asp-action="CompleteLesson" asp-route-id="@l.Id">
                    <button class="btn btn-primary btn-lg" type="submit">@Html.Icon("check") @(Model.NextId == null ? L.T("Завершить курс", "Курсты аяқтау", "Finish the course") : L.T("Урок пройден — дальше", "Сабақ өтілді — әрі қарай", "Done — next lesson"))</button>
                </form>
            }
            else if (Model.NextId is int nextId)
            {
                <a class="btn btn-primary btn-lg" href="/Student/Lesson/@nextId">@L.T("Следующий урок", "Келесі сабақ", "Next lesson") @Html.Icon("arrow-right", "icon-sm")</a>
            }
            else
            {
                <a class="btn btn-secondary btn-lg" href="/Student/CourseDetails/@Model.Course.Id">@L.T("К программе курса", "Курс бағдарламасына", "Back to the curriculum")</a>
            }
        </div>
    </article>

    <aside class="col gap-5">
        <div class="card">
            <div class="card-title mb-2">@Model.Course.Title</div>
            <div class="progress-row"><span>@L.T($"Урок {Model.Number} из {Model.Total}", $"{Model.Total} сабақтың {Model.Number}-і", $"Lesson {Model.Number} of {Model.Total}")</span><b>@Model.Course.Progress%</b></div>
            @Html.Progress(Model.Course.Progress, Model.Course.Progress == 100 ? "progress-sm progress-success" : "progress-sm")
            <a class="btn btn-outline btn-sm btn-block mt-4" href="/Student/CourseDetails/@Model.Course.Id">@Html.Icon("list", "icon-sm") @L.T("Программа курса", "Курс бағдарламасы", "Curriculum")</a>
        </div>
        <div class="card card-soft">
            <div class="flex items-center gap-3 mb-3"><span class="ai-avatar sm">@Html.Icon("sparkles")</span><b>AI @L.T("помощник", "көмекші", "assistant")</b></div>
            <p class="text-sm muted">@L.T("Что-то непонятно? Спросите — объясню другими словами.", "Бір нәрсе түсініксіз бе? Сұраңыз — басқаша түсіндіремін.", "Something unclear? Ask and I'll explain it differently.")</p>
            <a class="btn btn-primary btn-sm mt-4" href="/Student/Ai">@L.T("Спросить AI", "AI-дан сұрау", "Ask AI")</a>
        </div>
    </aside>
</div>
