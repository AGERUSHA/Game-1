@model MaterialPage
@{
    var m = Model.Material;
    ViewData["Title"] = m.Title;
    ViewData["Nav"] = "materials";
    var (icon, name) = m.Type switch
    {
        "video" => ("play-circle", L.T("Видео", "Бейне", "Video")),
        "pdf" => ("file-text", "PDF"),
        "presentation" => ("presentation", L.T("Презентация", "Презентация", "Slides")),
        _ => ("newspaper", L.T("Статья", "Мақала", "Article")),
    };
    var paragraphs = Model.Body.Replace("\r", "").Split("\n\n", StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
}

<nav class="breadcrumbs">
    <a href="/Student/Materials">@L.T("Материалы", "Материалдар", "Materials")</a> @Html.Icon("chevron-right") <span>@m.Title</span>
</nav>

<article class="card card-lg col gap-5" style="max-width:880px">
    <div class="flex gap-3 items-start wrap">
        <div class="col gap-2 grow">
            <div class="flex gap-2 wrap">
                <span class="badge badge-primary">@Html.Icon(icon) @name</span>
                @if (m.Meta.Length > 0) { <span class="badge">@m.Meta</span> }
            </div>
            <h1 style="font-size:28px">@m.Title</h1>
            <a class="text-sm muted" href="/Student/CourseDetails/@Model.CourseId">@Html.Icon("book-open", "icon-xs") @m.Course</a>
        </div>
        <form method="post" asp-action="SaveMaterial" asp-route-id="@m.Id">
            <input type="hidden" name="returnUrl" value="/Student/Material/@m.Id" />
            <button class="btn @(m.Saved ? "btn-secondary" : "btn-outline")" type="submit">@Html.Icon(m.Saved ? "bookmark-check" : "bookmark", "icon-sm") @(m.Saved ? L.T("В закладках", "Бетбелгіде", "Bookmarked") : L.T("В закладки", "Бетбелгіге", "Bookmark"))</button>
        </form>
    </div>

    @if (Model.VideoEmbed != null)
    {
        <div style="position:relative;padding-top:56.25%;border-radius:14px;overflow:hidden;background:#000">
            <iframe src="@Model.VideoEmbed" title="@m.Title" style="position:absolute;inset:0;width:100%;height:100%;border:0"
                    allow="accelerometer; encrypted-media; gyroscope; picture-in-picture; fullscreen" allowfullscreen loading="lazy"></iframe>
        </div>
    }

    @if (paragraphs.Length > 0)
    {
        <div class="col gap-4" style="font-size:16px;line-height:1.7">
            @foreach (var p in paragraphs)
            {
                <p style="margin:0">@Html.Raw(string.Join("<br>", p.Split('\n').Select(System.Net.WebUtility.HtmlEncode)))</p>
            }
        </div>
    }

    @if (Model.FileUrl != null)
    {
        <a class="btn btn-primary btn-lg" href="@Model.FileUrl" download>@Html.Icon("download") @L.T("Скачать файл", "Файлды жүктеу", "Download file")</a>
    }
    else if (Model.VideoEmbed == null && paragraphs.Length == 0)
    {
        <partial name="_EmptyState" model='new EmptyState("file-clock", L.T("Файл ещё не загружен", "Файл әлі жүктелмеген", "The file isn’t uploaded yet"), L.T("Преподаватель добавит его в ближайшее время.", "Оқытушы оны жақын арада қосады.", "The teacher will add it soon."))' />
    }
</article>
