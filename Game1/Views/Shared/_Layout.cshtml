@* Main application layout: Sidebar + Topbar + Content *@
<!DOCTYPE html>
<html lang="@L.Current">
<head>
    <partial name="_Head" />
    @await RenderSectionAsync("Head", required: false)
</head>
<body>
    <div class="app">
        <partial name="_Sidebar" />
        <div class="sidebar-backdrop" data-sidebar-toggle></div>

        <div class="main">
            <partial name="_Topbar" />
            <main class="content" id="main">
                @RenderBody()
            </main>
        </div>
    </div>
    <partial name="_BottomNav" />

    @if ((ViewData["Role"] as string ?? "student") == "student")
    {
        <partial name="_OwlBuddy" />
    }

    <partial name="_Scripts" />
    @* Message after a redirect (enrolled, lesson done, …) — unless the page already showed it in a _FormError block. *@
    @if (!Context.Items.ContainsKey("FlashShown") && (TempData["Success"] ?? TempData["Error"]) is string flash)
    {
        <script>window.eduToast(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(flash)), @Html.Raw(TempData["Error"] != null ? "\"alert-circle\"" : "\"check-circle-2\""));</script>
    }
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
