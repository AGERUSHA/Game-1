@{
    ViewData["Title"] = "Design System";
    var palette = new (string Name, string Var, string Hex)[]
    {
        ("Primary Purple", "--primary", "#7C3AED"), ("Light Purple", "--primary-light", "#F5F3FF"), ("Dark Purple", "--primary-dark", "#4C1D95"),
        ("Background", "--bg", "#F8F7FC"), ("Card", "--surface", "#FFFFFF"), ("Text", "--text", "#1B1530"),
        ("Secondary text", "--text-2", "#5E5A73"), ("Border", "--border", "#ECE9F5"),
        ("Success", "--success", "#16A34A"), ("Warning", "--warning", "#EA580C"), ("Error", "--error", "#DC2626"), ("Info", "--info", "#2563EB"),
    };
    var scale = new[] { "50", "100", "200", "300", "400", "500", "600", "700", "800", "900", "950" };
}

<div class="page-head">
    <div>
        <h1>@Html.Icon("palette", "icon-xl c-primary") EDU AI Design System</h1>
        <p>@L.T("Единая система токенов и компонентов для всех страниц платформы.", "Платформаның барлық беттеріне арналған бірыңғай токендер мен компоненттер жүйесі.", "One system of tokens and components for every page of the platform.")</p>
    </div>
    <span class="badge badge-primary badge-lg">wwwroot/css/edu.css</span>
</div>

<section class="card card-lg">
    <div class="card-title mb-4">Colors</div>
    <div class="grid" style="grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:14px">
        @foreach (var c in palette)
        {
            <div class="swatch"><i style="background:var(@c.Var)"></i><div><b>@c.Name</b><code>var(@c.Var)</code><br /><code>@c.Hex</code></div></div>
        }
    </div>
    <div class="card-title mt-8 mb-3">Purple scale</div>
    <div class="flex" style="border-radius:14px;overflow:hidden">
        @foreach (var s in scale)
        {
            <div class="grow text-center text-xs fw-600" style="background:var(--primary-@s);padding:26px 0 8px;color:@(int.Parse(s) >= 500 ? "#fff" : "var(--primary-900)")">@s</div>
        }
    </div>
</section>

<div class="grid cols-2 mt-6">
    <section class="card card-lg">
        <div class="card-title mb-4">Typography · Inter</div>
        <h1>Heading 1 · 32/800</h1>
        <h2 class="mt-3">Heading 2 · 22/700</h2>
        <h3 class="mt-3">Heading 3 · 18/700</h3>
        <p class="mt-3">Body 15/400 — @L.T("Учитесь. Развивайтесь. Достигайте большего.", "Оқыңыз. Дамыңыз. Көпке жетіңіз.", "Learn. Grow. Achieve more.")</p>
        <p class="mt-2 muted text-sm">Secondary 13 — Қазақша: ә ғ қ ң ө ұ ү һ і</p>
        <div class="stat-value mt-4">1 250 <small>XP</small></div>
    </section>
    <section class="card card-lg">
        <div class="card-title mb-4">Buttons</div>
        <div class="flex gap-3 wrap">
            <button class="btn btn-primary">Primary</button>
            <button class="btn btn-secondary">Secondary</button>
            <button class="btn btn-outline">Outline</button>
            <button class="btn btn-ghost">Ghost</button>
            <button class="btn btn-danger">Danger</button>
            <button class="btn btn-primary" disabled>Disabled</button>
        </div>
        <div class="flex gap-3 wrap mt-4 items-center">
            <button class="btn btn-primary btn-sm">Small</button>
            <button class="btn btn-primary">Default</button>
            <button class="btn btn-primary btn-lg">Large @Html.Icon("arrow-right")</button>
            <button class="btn btn-secondary btn-icon">@Html.Icon("heart")</button>
        </div>
        <div class="card-title mt-6 mb-3">Badges</div>
        <div class="flex gap-2 wrap">
            <span class="badge badge-primary">Primary</span><span class="badge badge-solid">Solid</span><span class="badge badge-success badge-dot">Success</span>
            <span class="badge badge-warning badge-dot">Warning</span><span class="badge badge-error badge-dot">Error</span><span class="badge badge-info badge-dot">Info</span><span class="badge">Neutral</span>
        </div>
    </section>
</div>

<div class="grid cols-3 mt-6">
    <section class="card">
        <div class="card-title mb-4">Inputs</div>
        <div class="col gap-4">
            <div class="field"><label class="label">Email</label><div class="input-group">@Html.Icon("mail")<input class="input" placeholder="name@edu.ai" /></div></div>
            <div class="field"><label class="label">Select</label><select class="select"><option>PHP &amp; Laravel</option></select></div>
            <div class="flex items-center justify-between"><label class="check"><input type="checkbox" checked /> Checkbox</label><label class="switch"><input type="checkbox" checked /><span></span></label></div>
            <div class="segmented"><button class="active">Week</button><button>Month</button><button>Year</button></div>
        </div>
    </section>
    <section class="card">
        <div class="card-title mb-4">Progress</div>
        <div class="col gap-4">
            @Html.Progress(72)
            @Html.Progress(90, "progress-success")
            @Html.Progress(45, "progress-warning")
            <div class="flex gap-4 items-center">@Html.Ring(72, 90, 9) @Html.Ring(50, 64, 7)</div>
        </div>
    </section>
    <section class="card card-hover">
        <div class="card-title mb-4">Card · hover me</div>
        <div class="flex gap-3 items-center"><span class="ibox">@Html.Icon("sparkles")</span><span class="ibox ibox-solid">@Html.Icon("zap")</span><span class="ibox ibox-success">@Html.Icon("check")</span><span class="ibox ibox-warning">@Html.Icon("flame")</span></div>
        <p class="text-sm muted mt-4">radius 18–24px · soft purple-tinted shadow · 1px border · translateY(-3px) on hover.</p>
        <div class="avatar-stack mt-4"><span class="avatar av-1">АС</span><span class="avatar av-2">НА</span><span class="avatar av-3">ДК</span><span class="avatar av-4">ЖО</span></div>
    </section>
</div>
