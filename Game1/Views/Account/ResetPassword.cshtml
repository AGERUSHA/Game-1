@{
    Layout = "_AuthLayout";
    ViewData["Title"] = L.T("Новый пароль", "Жаңа құпиясөз", "New password");
}
<div class="auth-card">
    <partial name="_Mascot" />
    <h2>@L.T("Придумайте новый пароль", "Жаңа құпиясөз ойлап табыңыз", "Choose a new password")</h2>
    <p class="sub">@L.T("Минимум 8 символов. Лучше — фраза из нескольких слов.", "Кемінде 8 таңба. Бірнеше сөзден тұратын тіркес жақсырақ.", "At least 8 characters — a phrase of several words is best.")</p>

    <form class="auth-form" method="post" asp-action="ResetPassword">
        <input type="hidden" name="token" value="@ViewData["Token"]" />
        <partial name="_FormError" />
        <div class="field">
            <label class="label" for="pw">@L.T("Новый пароль", "Жаңа құпиясөз", "New password")</label>
            <div class="input-group">
                @Html.Icon("lock")
                <input class="input" id="pw" name="newPassword" type="password" required minlength="8" data-pw-meter="#pwm" autocomplete="new-password" autofocus />
                <button class="icon-btn input-action" type="button" data-pw-toggle aria-label="@L.T("Показать пароль", "Құпиясөзді көрсету", "Show password")">@Html.Icon("eye")</button>
            </div>
            <div class="pw-meter" id="pwm"><i></i><i></i><i></i><i></i></div>
        </div>
        <div class="field">
            <label class="label" for="pw2">@L.T("Подтверждение пароля", "Құпиясөзді растау", "Confirm password")</label>
            <div class="input-group">@Html.Icon("shield-check")<input class="input" id="pw2" name="confirmPassword" type="password" required minlength="8" autocomplete="new-password" /></div>
        </div>
        <button class="btn btn-primary btn-lg btn-block" type="submit">@L.T("Сохранить пароль", "Құпиясөзді сақтау", "Save password") @Html.Icon("check")</button>
    </form>

    <p class="auth-foot"><a class="fw-600" href="/Account/ForgotPassword">@L.T("Запросить новую ссылку", "Жаңа сілтеме сұрау", "Request a new link")</a></p>
</div>
