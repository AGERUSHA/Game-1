@{
    Layout = "_AuthLayout";
    ViewData["Title"] = L.T("Восстановление пароля", "Құпиясөзді қалпына келтіру", "Reset password");
    var sent = ViewData["Sent"] as bool? ?? false;
}
<div class="auth-card">
    <partial name="_Mascot" />
    @if (sent)
    {
        <h2>@L.T("Проверьте почту", "Поштаңызды тексеріңіз", "Check your inbox")</h2>
        <p class="sub">
            @L.T($"Если аккаунт {ViewData["Email"]} существует, мы отправили на него ссылку для нового пароля. Она действует 1 час.",
                 $"Егер {ViewData["Email"]} аккаунты бар болса, оған жаңа құпиясөз сілтемесін жібердік. Ол 1 сағат жарамды.",
                 $"If an account for {ViewData["Email"]} exists, we've sent it a link to set a new password. It's valid for 1 hour.")
        </p>
        <p class="text-sm muted">@L.T("Не пришло? Проверьте папку «Спам» или попробуйте ещё раз через минуту.", "Келмеді ме? «Спам» қалтасын тексеріңіз немесе бір минуттан кейін қайталаңыз.", "Nothing yet? Check your spam folder or try again in a minute.")</p>
        <a class="btn btn-outline btn-lg btn-block mt-6" href="/Account/ForgotPassword">@L.T("Отправить ещё раз", "Қайта жіберу", "Send again")</a>
    }
    else
    {
        <h2>@L.T("Забыли пароль?", "Құпиясөзді ұмыттыңыз ба?", "Forgot your password?")</h2>
        <p class="sub">@L.T("Введите email — пришлём ссылку для нового пароля.", "Email енгізіңіз — жаңа құпиясөз сілтемесін жібереміз.", "Enter your email and we'll send a link to set a new password.")</p>
        <form class="auth-form" method="post" asp-action="ForgotPassword">
            <div class="field">
                <label class="label" for="email">Email</label>
                <div class="input-group">@Html.Icon("mail")<input class="input" id="email" name="email" type="email" placeholder="name@edu.ai" autocomplete="email" required autofocus /></div>
            </div>
            <button class="btn btn-primary btn-lg btn-block" type="submit">@L.T("Отправить ссылку", "Сілтеме жіберу", "Send link") @Html.Icon("send")</button>
        </form>
    }
    <p class="auth-foot"><a class="fw-600" href="/Account/Login">@Html.Icon("arrow-left", "icon-sm") @L.T("Вернуться ко входу", "Кіруге оралу", "Back to sign in")</a></p>
</div>
