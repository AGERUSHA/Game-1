@{
    Layout = "_AuthLayout";
    ViewData["Title"] = L.T("Подтверждение email", "Email растау", "Confirm email");
    var email = ViewData["Email"] as string ?? "";
    var returnUrl = ViewData["ReturnUrl"] as string;
}
<div class="auth-card">
    <partial name="_Mascot" />
    <h2>@L.T("Подтвердите email", "Email-ді растаңыз", "Confirm your email")</h2>
    <p class="sub">
        @L.T($"Мы отправили 6-значный код на {email}. Он действует 30 минут.",
             $"{email} поштасына 6 таңбалы код жібердік. Ол 30 минут жарамды.",
             $"We've sent a 6-digit code to {email}. It's valid for 30 minutes.")
    </p>

    <form class="auth-form" method="post" asp-action="ConfirmEmail">
        <input type="hidden" name="email" value="@email" />
        <input type="hidden" name="returnUrl" value="@returnUrl" />
        <partial name="_FormError" />
        <div class="field">
            <label class="label" for="code">@L.T("Код из письма", "Хаттағы код", "Code from the email")</label>
            <div class="input-group">@Html.Icon("key")<input class="input" id="code" name="code" type="text" inputmode="numeric" pattern="[0-9 ]{6,7}" maxlength="7" placeholder="123456" autocomplete="one-time-code" required autofocus /></div>
        </div>
        <button class="btn btn-primary btn-lg btn-block" type="submit">@L.T("Подтвердить", "Растау", "Confirm") @Html.Icon("check")</button>
    </form>

    <p class="text-sm muted mt-6">@L.T("Не пришло? Проверьте папку «Спам» или отправьте код ещё раз.", "Келмеді ме? «Спам» қалтасын тексеріңіз немесе кодты қайта жіберіңіз.", "Nothing yet? Check your spam folder or send the code again.")</p>
    <form method="post" asp-action="ResendConfirmation">
        <input type="hidden" name="email" value="@email" />
        <input type="hidden" name="returnUrl" value="@returnUrl" />
        <button class="btn btn-outline btn-lg btn-block" type="submit">@L.T("Отправить код ещё раз", "Кодты қайта жіберу", "Send the code again") @Html.Icon("send")</button>
    </form>

    <p class="auth-foot"><a class="fw-600" href="/Account/Login">@Html.Icon("arrow-left", "icon-sm") @L.T("Вернуться ко входу", "Кіруге оралу", "Back to sign in")</a></p>
</div>
