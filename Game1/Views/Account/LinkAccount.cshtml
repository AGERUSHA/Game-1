@model LinkAccountViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = L.T("Привязка аккаунта", "Аккаунтты байланыстыру", "Link account");
}
<div class="auth-card">
    <partial name="_Mascot" />
    <h2>@L.T("Аккаунт уже существует", "Аккаунт бар", "Account already exists")</h2>
    <p class="sub">
        @L.T($"Аккаунт с адресом {Model.Email} уже зарегистрирован. Введите его пароль один раз, чтобы привязать вход через {Model.Provider}.",
             $"{Model.Email} мекенжайымен аккаунт тіркелген. {Model.Provider} арқылы кіруді байланыстыру үшін құпиясөзді бір рет енгізіңіз.",
             $"An account with {Model.Email} is already registered. Enter its password once to link {Model.Provider} sign-in.")
    </p>

    <form class="auth-form" method="post" asp-action="LinkAccount">
        <input type="hidden" asp-for="ReturnUrl" />
        <partial name="_FormError" />
        <div class="field">
            <label class="label" for="email">Email</label>
            <div class="input-group">@Html.Icon("mail")<input class="input" id="email" type="email" value="@Model.Email" readonly /></div>
        </div>
        <div class="field">
            <label class="label" for="password">@L.T("Пароль", "Құпиясөз", "Password")</label>
            <div class="input-group">
                @Html.Icon("lock")
                <input class="input" id="password" name="Password" type="password" placeholder="••••••••" autocomplete="current-password" required autofocus />
                <button class="icon-btn input-action" type="button" data-pw-toggle aria-label="@L.T("Показать пароль", "Құпиясөзді көрсету", "Show password")">@Html.Icon("eye")</button>
            </div>
        </div>
        <button class="btn btn-primary btn-lg btn-block" type="submit">@L.T("Привязать и войти", "Байланыстырып кіру", "Link and sign in") @Html.Icon("link")</button>
    </form>

    <p class="auth-foot"><a class="fw-600" href="/Account/Login">@L.T("Отмена", "Болдырмау", "Cancel")</a></p>
</div>
